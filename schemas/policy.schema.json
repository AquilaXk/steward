{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:steward:policy:v1",
  "title": "Steward policy v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "rules": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "bytes",
        "rules"
      ]
    },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "on": {
            "type": "array",
            "items": {
              "enum": [
                "prompt",
                "tool",
                "session"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "effect": {
            "enum": [
              "inject",
              "deny"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000,
            "pattern": "\\S"
          },
          "required": {
            "type": "boolean"
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "always": {
                "const": true
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S",
                  "not": {
                    "pattern": "\\*"
                  }
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "textAny": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "wordsAny": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              },
              "pathPrefixes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S",
                  "not": {
                    "pattern": "(^/|\\\\|\\*|:|(^|/)\\.{1,2}(/|$))"
                  }
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              }
            },
            "required": [],
            "anyOf": [
              {
                "required": [
                  "always"
                ]
              },
              {
                "required": [
                  "textAny"
                ]
              },
              {
                "required": [
                  "wordsAny"
                ]
              },
              {
                "required": [
                  "pathPrefixes"
                ]
              }
            ],
            "allOf": [
              {
                "if": {
                  "required": [
                    "always"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "textAny"
                        ]
                      },
                      {
                        "required": [
                          "wordsAny"
                        ]
                      },
                      {
                        "required": [
                          "pathPrefixes"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "on",
          "effect",
          "priority",
          "body",
          "required",
          "match"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "effect": {
                  "const": "deny"
                }
              }
            },
            "then": {
              "properties": {
                "required": {
                  "const": false
                },
                "on": {
                  "not": {
                    "contains": {
                      "const": "session"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "match": {
                  "anyOf": [
                    {
                      "required": [
                        "tools"
                      ]
                    },
                    {
                      "required": [
                        "pathPrefixes"
                      ]
                    }
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "on": {
                  "const": [
                    "tool"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "budget",
    "rules"
  ],
  "$comment": "src/schema.mjs also checks unique IDs, UTF-8 byte lengths, token content, and semantic refinements. Editor schemas do not activate policies."
}
