{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:steward:journal-entry:v1",
  "title": "Steward user-authored journal entry v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "decision"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000,
              "pattern": "\\S"
            },
            "authority": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "user",
                    "delegated"
                  ]
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000,
                  "pattern": "\\S"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "reference",
                "quote"
              ]
            },
            "supersedes": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            }
          },
          "required": [
            "statement",
            "authority",
            "supersedes"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "question"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000,
              "pattern": "\\S"
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            },
            "resolution": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersedes": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            }
          },
          "required": [
            "question",
            "assumptions",
            "resolution",
            "supersedes"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "knowledge"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claim": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000,
              "pattern": "\\S"
            },
            "basis": {
              "enum": [
                "source",
                "observation",
                "assumption"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000,
                    "pattern": "\\S"
                  },
                  "checkedAt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT",
                    "format": "date-time"
                  }
                },
                "required": [
                  "reference",
                  "checkedAt"
                ]
              }
            },
            "expiresAt": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT",
                  "format": "date-time"
                }
              ]
            }
          },
          "required": [
            "claim",
            "basis",
            "sources",
            "expiresAt"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "basis": {
                    "const": "source"
                  }
                }
              },
              "then": {
                "properties": {
                  "sources": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "goal"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000,
              "pattern": "\\S"
            },
            "acceptance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "status": {
              "enum": [
                "active",
                "blocked",
                "complete"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "objective",
            "acceptance",
            "status",
            "evidence"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "checkpoint"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200,
              "pattern": "\\S"
            },
            "session": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA-256 of the host session ID; absent or null means unscoped."
            },
            "next": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800,
              "pattern": "\\S"
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 8,
              "uniqueItems": true
            }
          },
          "required": [
            "summary",
            "next",
            "blockers"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "schedule"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000,
              "pattern": "\\S"
            },
            "dueAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT",
              "format": "date-time"
            },
            "status": {
              "enum": [
                "planned",
                "staged",
                "completed",
                "cancelled"
              ]
            },
            "members": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "title",
            "dueAt",
            "status",
            "members"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "handoff"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000,
              "pattern": "\\S"
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            },
            "acceptance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "task",
            "scope",
            "constraints",
            "acceptance",
            "evidence"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    }
  ],
  "$comment": "The verification type is reserved for the command runner. Runtime enforces 32 KiB entry and 4096-byte checkpoint limits, valid supersede targets, and current evidence for complete goals."
}
