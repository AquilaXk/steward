{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:steward:verification:v1",
  "title": "Steward verification plan v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "maxAgeSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            ],
            "items": {
              "type": "string",
              "maxLength": 16384,
              "not": {
                "pattern": "\u0000"
              }
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 50,
            "maximum": 120000
          }
        },
        "required": [
          "id",
          "description",
          "argv",
          "timeoutMs"
        ]
      }
    }
  },
  "required": [
    "version",
    "maxAgeSeconds",
    "checks"
  ],
  "$comment": "Runtime also checks unique check IDs, UTF-8 byte lengths, and a total timeout budget of 600000 ms. Commands run as argv with shell:false."
}
